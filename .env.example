# Copie para .env e preencha:  cp .env.example .env
# O .env é ignorado pelo git. Nunca commite senhas ou chaves.

# ---------------------------------------------------------------------------
# Backend (npm run dev, npm start e npm run seed)
# ---------------------------------------------------------------------------

# Porta HTTP do backend. Opcional; padrão 8080.
PORT=8080

# Endereço do MongoDB. Obrigatório.
# Com o MongoDB do docker compose (ou outro local na porta 27017):
MONGO_URI=mongodb://localhost:27017/compensar

# Chave que assina e verifica os tokens JWT. Obrigatória; também usada pelo docker compose.
# Gere uma chave aleatória com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRIVATE_KEY=

# Arquivo de questões para o npm run seed (JSON ou JSON Lines do mongoexport). Opcional;
# sem ele, o seed carrega as questões de exemplo de src/seed/data/questions.json.
# SEED_QUESTIONS_FILE=

# ---------------------------------------------------------------------------
# docker compose (lidas só pelo docker-compose.yml)
# ---------------------------------------------------------------------------

# Caminho do repositório do frontend (compensar-gui). Opcional; padrão ../compensar-gui.
# FRONTEND_PATH=../compensar-gui

# Portas publicadas na sua máquina. Opcionais; padrões 27017, 8080 e 3000.
# MONGO_PORT=27017
# BACKEND_PORT=8080
# FRONTEND_PORT=3000
